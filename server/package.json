{
  "name": "savethedragon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx watch index.ts",
    "start:prod": "node dist/index.js",
    "test": "vitest run",
    "simulate:deck": "tsx simulation/deckBalanceSimulator.ts",
    "simulate": "tsx simulation/runSimulation.ts",
    "simulate:js": "node dist/simulation/runSimulation.js",
    "simulate:compare": "tsx simulation/runSimulation.ts --compare=true",
    "autobalance": "tsx simulation/autoBalance.ts",
    "autobalance:js": "node dist/simulation/autoBalance.js"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  }
}
